{
    "name": "svelte-select",
    "version": "6.0.0",
    "repository": "https://rob-balfre@github.com/rob-balfre/svelte-select.git",
    "description": "A <Select> component for Svelte apps",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "test": "vitest run --browser",
        "test:watch": "vitest --browser",
        "gen:docs": "node docs/generate_theming_variables_md.js",
        "prepare": "npm run package",
        "package": "node src/remove-styles.js && svelte-package -o package && node src/post-prepare.js && npm run gen:docs",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish"
    },
    "peerDependencies": {
        "svelte": ">=5"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@sveltejs/adapter-auto": "^3.0.0",
        "@sveltejs/adapter-static": "^3.0.0",
        "@sveltejs/kit": "^2.66.0",
        "@sveltejs/package": "^2.3.7",
        "@sveltejs/vite-plugin-svelte": "^4.0.0",
        "@vitest/browser": "^3.2.4",
        "autoprefixer": "^10.4.14",
        "cross-env": "^7.0.3",
        "find-in-files": "^0.5.0",
        "fuse.js": "^6.6.2",
        "playwright": "^1.54.2",
        "prettier": "~3.8.4",
        "prettier-plugin-svelte": "^3.2.6",
        "svelte": "^5.56.4",
        "svelte-check": "^4.6.0",
        "svelte-highlight": "^7.2.1",
        "svelte-preprocess": "^6.0.0",
        "svelte-tiny-virtual-list": "^2.0.5",
        "typescript": "^5.5.0",
        "vite": "^5.4.4",
        "vitest": "^3.2.4"
    },
    "author": "Robert Balfré <rob.balfre@gmail.com> (https://github.com/rob-balfre)",
    "license": "ISC",
    "keywords": [
        "svelte"
    ],
    "packageManager": "pnpm@10.4.0",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./package/index.d.ts",
            "svelte": "./package/index.js"
        },
        "./no-styles": {
            "types": "./package/no-styles/Select.svelte.d.ts",
            "svelte": "./package/no-styles/Select.svelte"
        },
        "./no-styles/Select.svelte": {
            "types": "./package/no-styles/Select.svelte.d.ts",
            "svelte": "./package/no-styles/Select.svelte"
        },
        "./tailwind.css": "./package/tailwind.css"
    },
    "dependencies": {
        "svelte-floating-ui": "1.5.8"
    },
    "files": [
        "package"
    ],
    "svelte": "./package/index.js",
    "types": "./package/index.d.ts"
}
