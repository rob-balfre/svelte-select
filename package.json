{
    "name": "svelte-select",
    "version": "5.8.3",
    "repository": "https://rob-balfre@github.com/rob-balfre/svelte-select.git",
    "description": "A <Select> component for Svelte apps",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run --browser",
        "test:watch": "vitest --browser",
        "gen:docs": "node docs/generate_theming_variables_md.cjs",
        "preprepare": "node src/remove-styles.js",
        "prepare": "svelte-package -o package",
        "postprepare": "node src/post-prepare.cjs && npm run gen:docs",
        "release": "release-it"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^3.0.0",
        "@sveltejs/adapter-static": "^3.0.0",
        "@sveltejs/kit": "^2.66.0",
        "@sveltejs/package": "^2.0.0",
        "@sveltejs/vite-plugin-svelte": "^3.0.0",
        "autoprefixer": "^10.4.14",
        "cross-env": "^7.0.3",
        "find-in-files": "^0.5.0",
        "fuse.js": "^6.6.2",
        "prettier": "~2.8.7",
        "prettier-plugin-svelte": "^2.10.1",
        "release-it": "^15.10.0",
        "svelte": "^4.0.0",
        "svelte-highlight": "^7.2.1",
        "svelte-preprocess": "^5.0.3",
        "svelte-tiny-virtual-list": "^2.0.5",
        "@vitest/browser": "^3.2.4",
        "playwright": "^1.54.2",
        "typescript": "^5.0.0",
        "vitest": "^3.2.4",
        "vite": "^5.0.0"
    },
    "author": "Robert Balfré <rob.balfre@gmail.com> (https://github.com/rob-balfre)",
    "license": "ISC",
    "keywords": [
        "svelte"
    ],
    "release-it": {
        "hooks": {
            "after:bump": "npm run prepare"
        },
        "github": {
            "release": false
        },
        "npm": {
            "publishPath": "./package"
        }
    },
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./package/index.d.ts",
            "svelte": "./package/index.js"
        }
    },
    "dependencies": {
        "svelte-floating-ui": "1.5.8"
    },
    "files": [
        "package"
    ],
    "svelte": "./package/index.js",
    "types": "./package/index.d.ts"
}
